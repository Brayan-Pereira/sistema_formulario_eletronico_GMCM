# =============================================================================
# Configurações do Sistema — Guarda Municipal
# Copie este arquivo para ".env" e ajuste os valores antes de iniciar.
# NUNCA commite o arquivo .env no controle de versão!
# =============================================================================

# ---------------------------------------------------------------------------
# SEGURANÇA — OBRIGATÓRIO ALTERAR EM PRODUÇÃO
# Gere uma chave segura com:  python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SECRET_KEY=TROQUE_ESTA_CHAVE_PARA_UMA_STRING_ALEATORIA_LONGA

# Duração do token de login em minutos (480 = 8 horas / 1 turno)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------------------------------------------------------------------------
# CLOUDFLARE TUNNEL
# Após executar "cloudflared tunnel --url http://localhost:8000",
# copie a URL gerada (ex: https://xyz.trycloudflare.com) aqui.
# Esta URL é embutida nos QR Codes gerados.
# ---------------------------------------------------------------------------
CLOUDFLARE_PUBLIC_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------------
PORT=8000

# ---------------------------------------------------------------------------
# CREDENCIAIS DO ADMINISTRADOR PADRÃO
# Usadas apenas no setup inicial (scripts/setup.bat).
# TROQUE a senha após o primeiro login!
# ---------------------------------------------------------------------------
ADMIN_MATRICULA=ADMIN001
ADMIN_SENHA=TroqueEstaSenha@123

# ---------------------------------------------------------------------------
# LIMITES
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=20

# ---------------------------------------------------------------------------
# GOOGLE DRIVE (opcional — para QR Code com link temporário)
# Para ativar:
#   1. Crie um projeto em https://console.cloud.google.com
#   2. Ative a API "Google Drive API"
#   3. Crie uma Service Account e baixe a chave JSON
#   4. Salve o JSON em: secrets/gdrive_service_account.json
#   5. Crie uma pasta no Drive e compartilhe com o e-mail da Service Account
#   6. Copie o ID da pasta (último segmento da URL do Drive) em GDRIVE_FOLDER_ID
# ---------------------------------------------------------------------------
GDRIVE_ENABLED=false
GDRIVE_SERVICE_ACCOUNT_FILE=./secrets/gdrive_service_account.json
GDRIVE_FOLDER_ID=
GDRIVE_DELETE_AFTER_SECONDS=120
